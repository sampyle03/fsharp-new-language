<Window x:Class="NumeraGUI.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numera Help"
        Height="600"
        Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <!-- Blue bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Close button -->
        </Grid.RowDefinitions>

        <!-- Blue top bar -->
        <Grid Grid.Row="0" Background="#6CB4EE" Height="55">
            <TextBlock Text="How to use Numera"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Courier New"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>
        </Grid>

        <!-- Scrollable text content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20">
            <TextBlock TextAlignment="Left"
                       FontFamily="Courier New"
                       FontSize="17"
                       TextWrapping="Wrap">
                <Bold>Welcome to Numera! Here's how to get started:</Bold>
                <LineBreak/><LineBreak/>
                <Run Text="Enter an expression in the left-hand box."/>
                <LineBreak/>
                <Run Text="Click Run to evaluate the expression."/>
                <LineBreak/>
                <Run Text="The result appears in the Output box."/>
                <LineBreak/>
                <Run Text="Errors will appear in the Errors box."/>
                <LineBreak/> <LineBreak/>
                <Bold>To define a variable use the format: </Bold>
                <LineBreak/>
                <Run Text="let [variableType] = [value];"/>
                <LineBreak/>
                <Run Text="For example: let int x = 5;"/>
                <LineBreak/> <LineBreak/>
                <Run Text="You are able to then use this variable for expressions and it will appear in the 'Current variables' box."/>
                <LineBreak/>
                <Run Text="You are also able to use these variables for plotting."/>
                <LineBreak/>
                <Run Text="Multi-line expressions are supported."/>
                <LineBreak/>
                <Run Text="The 'Clear' button will clear the output, errors and input boxes but your variables will remain."/>
                <LineBreak/>
                <Bold>Once variables are defined they cannot be redefined.</Bold>

            </TextBlock>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="2"
                Content="Close"
                FontFamily="Courier New"
                Width="80"
                Height="30"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"
                IsDefault="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
