<Window x:Class="NumeraGUI.PlotHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numera Plot Help"
        Height="400"
        Width="600"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <!-- Blue bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Close button -->
        </Grid.RowDefinitions>

        <!-- Blue top bar -->
        <Grid Grid.Row="0" Background="#6CB4EE" Height="55">
            <TextBlock Text="How to use Numera plotting"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Courier New"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>
        </Grid>

        <!-- Scrollable text content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20">
            <TextBlock TextAlignment="Center"
                       FontFamily="Courier New"
                       FontSize="16"
                       TextWrapping="Wrap"
                       Text=" Enter an expression in the input box using the format:&#x0a;&#x0a;graph x = expression, (x_min, x_max); &#x0a;&#x0a; For example: graph x = a*x + b, (-10, 10);&#x0a;(where a and b have previosuly been defined)&#x0a;&#x0a;Click the 'Plot' button.&#x0a;&#x0a;Then your plot will appear in the space below!&#x0a;&#x0a;Use the 'Clear' button for a clean plot.">

            </TextBlock>
        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="2"
                Content="Close"
                FontFamily="Courier New"
                Width="80"
                Height="30"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"
                IsDefault="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
