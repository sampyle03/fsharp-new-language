<Window x:Class="NumeraGUI.PlotHelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numera Plot Help"
        Height="600"
        Width="750"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize">

    <Grid Background="White">
        <Grid.RowDefinitions>
            <RowDefinition Height="55"/>
            <!-- Blue bar -->
            <RowDefinition Height="*"/>
            <!-- Content -->
            <RowDefinition Height="Auto"/>
            <!-- Close button -->
        </Grid.RowDefinitions>

        <!-- Blue top bar -->
        <Grid Grid.Row="0" Background="#6CB4EE" Height="55">
            <TextBlock Text="How to use Numera plotting"
                       FontSize="24"
                       FontWeight="Bold"
                       FontFamily="Courier New"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"
                       Foreground="Black"/>
        </Grid>

        <!-- Scrollable text content -->
        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Margin="20">
            <TextBlock FontFamily="Courier New"
                       FontSize="16"
                       TextWrapping="Wrap"
                       TextAlignment="Left">    

                <Bold>Enter an expression in the input box using one of the following formats:</Bold>
                <LineBreak/><LineBreak/>

                <Run Text="graph y = expression, (x_min, x_max, optional step);"/>
                <LineBreak/>
                <Run Text="graphdif y = expression, (x_min, x_max, optional step);"/>
                <LineBreak/>
                <Run Text="graphint y = expression, (x_min, x_max, optional step);"/>
                <LineBreak/><LineBreak/>

                <Bold>Examples:</Bold>
                <LineBreak/>
                <Run Text="graph y = a*x + b, (-10, 10, 5);"/>
                <LineBreak/>
                <Run Text="graphdif y = x^2, (-5, 5);"/>
                <LineBreak/>
                <Run Text="graphint y = x^3, (-2, 2, 0.1);"/>
                <LineBreak/><LineBreak/>

                <Run Text="Any variables used must have been previously defined."/>
                <LineBreak/><LineBreak/>

                <Bold>graph</Bold><Run Text=" plots the function y = f(x)"/>
                <LineBreak/>
                <Bold>graphdif</Bold><Run Text=" plots the numerical derivative dy/dx of the function"/>
                <LineBreak/>
                <Bold>graphint</Bold><Run Text=" plots the numerical integral of the function from x_min to x"/>
                <LineBreak/><LineBreak/>

                <Run Text="If no step size is defined, the default of 200 samples will be used."/>
                <LineBreak/><LineBreak/>

                <Run Text="Click the 'Plot' button to generate the graph."/>
                <LineBreak/><LineBreak/>

                <Run Text="Use the 'Clear' button for a clean plotting area."/>

            </TextBlock>

        </ScrollViewer>

        <!-- Close button -->
        <Button Grid.Row="2"
                Content="Close"
                FontFamily="Courier New"
                Width="80"
                Height="30"
                HorizontalAlignment="Center"
                Margin="0,10,0,20"
                IsDefault="True"
                Click="CloseButton_Click"/>
    </Grid>
</Window>
