<!--
    PlotWindow.xaml

    This window is responsible for plotting mathematical functions
    generated by the F# interpreter.

    The user enters a graph command (e.g. graph x = x^2, (-5, 5);),
    which is evaluated in Program1.fs. The resulting coordinates are
    then drawn onto the canvas below.
-->

<Window x:Class="NumeraGUI.PlotWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Numera Plotting"
        Height="800"
        Width="1200">

    <DockPanel>

        <!-- ===================== HEADER / NAV BAR ===================== -->
        <!--
            Top navigation bar.
            This matches the MainWindow header styling exactly.
        -->
        <Grid DockPanel.Dock="Top"
              Background="#6CB4EE"
              Height="65">

            <!-- Application title (centred) -->
            <TextBlock Text="Numera"
                       FontSize="30"
                       FontWeight="Bold"
                       FontFamily="Courier New"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>

            <!-- Help button (top-right, same as MainWindow) -->
            <Button x:Name="HelpButton"
                    Width="32"
                    Height="32"
                    Margin="0,4,40,4"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Right"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="0"
                    Click="HelpButton_Click"
                    ToolTip="Click for help"
                    ToolTipService.InitialShowDelay="200">

                <Grid Width="32" Height="32">
                    <Ellipse Width="32"
                             Height="32"
                             Stroke="Black"
                             StrokeThickness="3"
                             Fill="Transparent"/>

                    <TextBlock Text="?"
                               FontSize="20"
                               FontWeight="Bold"
                               Foreground="Black"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"/>
                </Grid>
            </Button>
        </Grid>

        <!-- ===================== MAIN CONTENT ===================== -->
        <Grid Margin="40">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <!-- Input row -->
                <RowDefinition Height="*"/>
                <!-- Plot area -->
            </Grid.RowDefinitions>

            <!-- ========== INPUT CONTROLS ========== -->
            <StackPanel Grid.Row="0"
                        HorizontalAlignment="Center"
                        Margin="0,10,0,20">

                <TextBlock Text="Enter expression:"
                           FontFamily="Courier New"
                           FontSize="20"
                           FontWeight="SemiBold"
                           HorizontalAlignment="Center"
                           Margin="0,0,0,5"/>

                <TextBox x:Name="FunctionTextBox"
                         Width="300"
                         FontFamily="Courier New"
                         FontSize="14"
                         TextAlignment="Center"/>

                <StackPanel Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            Margin="0,10,0,0">

                    <Button Content="Plot"
                            FontSize="14"
                            FontFamily="Courier New"
                            FontWeight="SemiBold"
                            Width="110"
                            Height="40"
                            Margin="0,0,30,0"
                            Padding="8,4"
                            Click="PlotButton_Click"/>

                    <Button Content="Clear"
                            FontSize="14"
                            FontFamily="Courier New"
                            FontWeight="SemiBold"
                            Width="110"
                            Height="40"
                            Margin="0,0,0,0"
                            Padding="8,4"
                            Click="ClearButton_Click"/>
                </StackPanel>
            </StackPanel>

            <!-- ========== PLOT CANVAS ========== -->
            <!--
                This canvas is where the axes, gridlines, tick labels,
                and plotted function are drawn.
            -->
            <Border Grid.Row="1"
                    BorderBrush="Black"
                    BorderThickness="1"
                    CornerRadius="4">

                <Canvas x:Name="PlotCanvas"
                        Background="White"/>
            </Border>

        </Grid>
    </DockPanel>
</Window>
